# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings -> API) ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Server-only. Bypasses row level security, so keep it out of any NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=images

# --- App --------------------------------------------------------------------------
# Public URL of this site; PhonePe sends customers back to <this>/PaymentSuccess
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Admin dashboard login (replaces the hard-coded admin@gmail.com / admin@123)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Customer OTP login ----------------------------------------------------------
# true  = the code is shown on screen instead of texted (local development ONLY;
#         with this on, anyone can sign in as any phone number)
# false = the code is sent by SMS through Twilio
OTP_DEV_MODE=true
OTP_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- PhonePe Standard Checkout -----------------------------------------------------
# MOCK (local: payments always succeed, no gateway), SANDBOX or PRODUCTION
PHONEPE_ENV=SANDBOX
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
